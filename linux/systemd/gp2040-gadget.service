[Unit]
Description=GP2040-CE USB HID gadget (configfs)
After=sys-kernel-config.mount
Before=gp2040-linux.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/gp2040-gadget up /etc/gp2040-linux.conf
ExecStop=/usr/local/bin/gp2040-gadget down
Environment=GP2040_LINUX=/usr/local/bin/gp2040-linux

[Install]
WantedBy=multi-user.target
